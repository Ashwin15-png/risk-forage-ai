# ========================================================
# SIH 26105 - Cyber Risk Quantification Platform
# Backend Environment Configuration
# ========================================================

# Neon PostgreSQL Database Connection URL (Recommended format)
# Format: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Or: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# Application Secrets & CORS
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: path to Firebase service account key JSON (for full admin access)
# FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# Optional External Integrations
LLM_API_KEY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Localization & Environment Defaults
DEFAULT_CURRENCY=INR
DEMO_MODE=true
ENVIRONMENT=development
